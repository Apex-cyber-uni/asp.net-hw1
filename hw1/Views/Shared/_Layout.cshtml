<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Personal Page</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/hw1.styles.css" asp-append-version="true" />
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, sans-serif; background-color: #f4f6f9; color: #333; margin: 0; }
        header { background-color: #2c3e50; color: #fff; padding: 20px 0; text-align: center; }
        nav { background-color: #34495e; padding: 15px; text-align: center; }
        nav a { color: #fff; text-decoration: none; margin: 0 15px; font-weight: bold; font-size: 16px; }
        nav a:hover { text-decoration: underline; color: #1abc9c; }
        .container { max-width: 800px; margin: 30px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        h1, h2, h3 { color: #2c3e50; }
        img { width: 100%; max-height: 350px; object-fit: cover; border-radius: 8px; margin-bottom: 20px; }
        p, li { line-height: 1.6; font-size: 16px; }
        ul { margin-bottom: 20px; }
        
        .hobby-section { margin-bottom: 30px; border-bottom: 1px solid #eee; padding-bottom: 20px; }
        .hobby-section:last-child { border-bottom: none; }
        .image-gallery { display: flex; gap: 15px; margin-top: 15px; }
        .image-gallery img { width: 50%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 0; }
        .fav-list { background-color: #fdfdfd; border-left: 4px solid #1abc9c; padding: 10px 10px 10px 30px; margin-bottom: 20px; }
    </style>
</head>
<body>
    <header>
        <h1>Мій Особистий Блог</h1>
    </header>    
    <nav>
        <a asp-controller="Home" asp-action="Index">Головна</a>
        <a asp-controller="Home" asp-action="AboutMe">Про мене</a>
        <a asp-controller="Home" asp-action="MyHobbies">Мої хобі</a>
        <a asp-controller="Home" asp-action="Favourites">Улюблене</a>
        <a asp-controller="Home" asp-action="MyPlans">Мої плани</a>
    </nav>
    <div class="container">
        @RenderBody() 
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
